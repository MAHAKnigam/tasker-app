# ========================================
# TASKER APPLICATION ENVIRONMENT CONFIG
# ========================================

# ========== DATABASE CONFIGURATION ==========
# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@host/database
MONGODB_URI=mongodb+srv://tasker_user:3J4aDyhKmPL2Rf@cluster03.nm2ebgb.mongodb.net/tasker?retryWrites=true&w=majority&appName=Cluster03

# ========== AUTHENTICATION CONFIGURATION ==========
# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Used to sign and verify JWT tokens
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# JWT Expiration Time
# Format: number + unit (d=days, h=hours, m=minutes)
JWT_EXPIRE=7d

# ========== EMAIL CONFIGURATION ==========
# Gmail SMTP Configuration
# IMPORTANT: Use an App Password, NOT your regular Gmail password
# Get App Password: https://myaccount.google.com/apppasswords

# Your Gmail email address
EMAIL_USER=your-email@gmail.com

# Gmail App Password (16 character password from Google Account)
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ========== APPLICATION CONFIGURATION ==========
# Node Environment (development, production, test)
NODE_ENV=production

# Backend Server Port
PORT=5000

# ========== FRONTEND CONFIGURATION ==========
# API URL for Frontend Requests
# Docker: Use 'backend' service name
# Local: http://localhost:5000
REACT_APP_API_URL=http://localhost:5000

# ========================================
# DOCKER CONFIGURATION
# ========================================

# Uncomment the following for Docker deployment
# MONGODB_URI is fetched from docker-compose.yml default
# JWT_SECRET defaults to change-me-in-production

# For Docker Compose:
# - Services communicate via: backend:5000
# - From outside Docker: localhost:5000

# ========================================
# OPTIONAL CONFIGURATIONS
# ========================================

# Enable debug logging (true/false)
# DEBUG=false

# Log level (error, warn, info, debug)
# LOG_LEVEL=info

# Session timeout in minutes
# SESSION_TIMEOUT=30

# Max task creation per user
# MAX_TASKS_PER_USER=unlimited

# ========================================
# NOTES
# ========================================

# 1. Create this file as '.env' in the project root
# 2. Never commit .env file to version control
# 3. Don't share your JWT_SECRET or EMAIL_PASSWORD
# 4. Change JWT_SECRET before deploying to production
# 5. Use environment-specific secrets for each deployment
# 6. Docker containers read from this file via docker-compose

# ========================================
# DEPLOYMENT CHECKLIST
# ========================================

# ✓ Update MONGODB_URI with your database
# ✓ Change JWT_SECRET to a strong random string
# ✓ Configure EMAIL_USER and EMAIL_PASSWORD for notifications
# ✓ Set NODE_ENV to 'production'
# ✓ Verify REACT_APP_API_URL matches backend location
# ✓ Review all settings with security team
# ✓ Store secrets in production environment safely
# ✓ Never commit secrets to git

# ========================================
