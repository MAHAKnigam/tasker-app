# ========================================
# TASKER APPLICATION ENVIRONMENT CONFIG
# ========================================

# ========== DATABASE CONFIGURATION ==========
# MongoDB Atlas connection string.
# Set the real value only in your hosting provider's environment variables.
# Never commit real credentials to Git.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# ========== AUTHENTICATION CONFIGURATION ==========
# Replace with a long, random secret in your hosting environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# ========== EMAIL CONFIGURATION ==========
# Optional Gmail SMTP configuration. Use a Google App Password, not your
# regular Gmail password. Keep both values in hosting environment variables.
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_google_app_password

# ========== APPLICATION CONFIGURATION ==========
NODE_ENV=production
PORT=5000

# ========== FRONTEND CONFIGURATION ==========
# Set this to the deployed backend URL when building the frontend.
REACT_APP_API_URL=https://your-backend-domain.example

# ========================================
# NOTES
# ========================================
# 1. Create a local .env file from this template for development.
# 2. Never commit .env files or real credentials to version control.
# 3. Set MONGODB_URI, JWT_SECRET, and any email credentials in your host's
#    environment-variable settings.
# 4. Set REACT_APP_API_URL in Netlify to the deployed backend URL, then
#    trigger a new frontend deployment.
# 5. A password removed from this file may remain in older Git commits.
#    Rotate exposed credentials; editing this template does not erase history.
